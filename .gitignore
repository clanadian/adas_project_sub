# HLS/Vivado 생성물. run_hls.tcl 과 소스에서 재생성 가능하다
*_prj/
*.jou
*.log
*.log.old
.Xil/

# 팀 전달용 원본 압축 파일. 필요한 소스는 저장소에 별도로 반영한다.
docs/*.zip

# PetaLinux가 재생성하는 SD 배포용 바이너리만 제외한다 - burn_sd.sh 등
# 스크립트는 arty/deploy/ 바로 아래에 있으므로 이 디렉터리 자체는 추적한다.
arty/deploy/*_sd_boot/
arty/deploy/rootfs.ext4

# 카메라/ROI 수동 검증 산출물
jetson/artifacts/

# CMake / C++ build outputs. build_arm/, build_verify/ 처럼 build 뒤에
# 접미사가 붙는 크로스컴파일용 디렉터리도 전부 잡는다.
build*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
!arty/ps_db/kernel/Makefile
!arty/classifier_linux_db/project-spec/meta-user/recipes-modules/adas-classifier/files/Makefile
*.o
*.obj

# Python
__pycache__/
*.py[cod]

# Jetson에서 재생성하는 TensorRT 및 A/B/C 실험 산출물.
*.engine
*.plan
jetson/models/classifier_benchmark/

# bitbake 가 만드는 build/ 안쪽으로 향하는 절대경로 심볼릭 링크
arty/ps_db/oe-logs
arty/ps_db/oe-workdir

# XSA 에서 다시 추출되는 하드웨어 기술 파일. 원본은 arty/hardware/ 에 둔다.
# 여기에 두면 mrproper 가 XSA 까지 같이 지운다.
arty/classifier_linux_db/project-spec/hw-description/
